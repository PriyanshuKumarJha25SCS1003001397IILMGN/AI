# Simple Movie Recommendation System
# Content-Based Filtering

movies = {
    "Inception": {
        "genres": {"action", "sci-fi", "thriller"}
    },
    "The Matrix": {
        "genres": {"action", "sci-fi", "thriller"}
    },
    "Interstellar": {
        "genres": {"sci-fi", "drama", "adventure"}
    },
    "The Dark Knight": {
        "genres": {"action", "crime", "drama"}
    },
    "Avengers: Endgame": {
        "genres": {"action", "sci-fi", "adventure"}
    },
    "The Hangover": {
        "genres": {"comedy"}
    },
    "Superbad": {
        "genres": {"comedy"}
    },
    "Titanic": {
        "genres": {"romance", "drama"}
    },
    "The Notebook": {
        "genres": {"romance", "drama"}
    },
    "Jurassic Park": {
        "genres": {"adventure", "sci-fi", "thriller"}
    }
}


def recommend_movies(user_preferences, watched_movies=None):
    if watched_movies is None:
        watched_movies = set()

    recommendations = []

    for movie, details in movies.items():

        # Don't recommend movies the user has already watched
        if movie in watched_movies:
            continue

        # Calculate similarity
        matching_genres = (
            user_preferences.intersection(details["genres"])
        )

        score = len(matching_genres)

        if score > 0:
            recommendations.append(
                (movie, score, matching_genres)
            )

    # Sort by highest similarity score
    recommendations.sort(
        key=lambda x: x[1],
        reverse=True
    )

    return recommendations


# Get user preferences
print("=== Movie Recommendation System ===")

print("\nAvailable genres:")
print("action, sci-fi, thriller, drama, adventure, comedy, crime, romance")

preferences = input(
    "\nEnter your favorite genres separated by commas: "
)

user_preferences = {
    genre.strip().lower()
    for genre in preferences.split(",")
}

# Get movies already watched
watched = input(
    "Enter movies you have already watched (comma-separated), "
    "or press Enter to skip: "
)

watched_movies = {
    movie.strip()
    for movie in watched.split(",")
    if movie.strip()
}

# Generate recommendations
recommendations = recommend_movies(
    user_preferences,
    watched_movies
)

# Display results
print("\n=== Recommended Movies ===")

if recommendations:
    for movie, score, genres in recommendations[:5]:
        print(
            f"- {movie} "
            f"(matching genres: {', '.join(genres)})"
        )
else:
    print("Sorry, no matching movies were found.")
